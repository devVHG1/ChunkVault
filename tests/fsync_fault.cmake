file(MAKE_DIRECTORY "${TEST_DIR}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "${TEST_DIR}/${run_id}")
set(repo "${work}/vault")
set(source "${work}/input")
file(MAKE_DIRECTORY "${source}")
file(WRITE "${source}/data" "data")

function(call expected failure)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "CV_TEST_FAIL_DIR_SYNC_AT=${failure}" "${CV}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL expected)
        message(FATAL_ERROR "Unexpected status ${status} for ${ARGN}\n${stdout}${stderr}")
    endif()
    set(diagnostic "${stderr}" PARENT_SCOPE)
endfunction()

call(0 0 init "${repo}")
call(1 1 backup "${repo}" "${source}" hidden)
if(EXISTS "${repo}/snapshots/hidden.cvm")
    message(FATAL_ERROR "Manifest was published before object directory synchronization")
endif()
call(1 2 backup "${repo}" "${source}" visible)
if(NOT diagnostic MATCHES "snapshot is visible")
    message(FATAL_ERROR "The post-publication diagnostic was missing")
endif()
call(0 0 verify "${repo}" visible)

call(1 1 restore "${repo}" visible "${work}/hidden-output")
file(GLOB hidden "${work}/hidden-output*")
if(hidden)
    message(FATAL_ERROR "Failed restore left an output directory: ${hidden}")
endif()
call(1 2 restore "${repo}" visible "${work}/visible-output")
file(READ "${work}/visible-output/data" restored)
if(NOT restored STREQUAL "data" OR NOT diagnostic MATCHES "restore is visible")
    message(FATAL_ERROR "The published restore was lost or the diagnostic was missing")
endif()
file(REMOVE_RECURSE "${work}")
