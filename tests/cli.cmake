set(status 0)
set(usage "Usage: cv [--help | --version]\n       cv init REPO\n       cv backup REPO SOURCE [SNAPSHOT]\n       cv list REPO\n       cv verify REPO [SNAPSHOT]\n       cv restore REPO SNAPSHOT DESTINATION\n       cv recover REPO [--remove]\n")
set(stdout "")
set(stderr "")
if(CASE STREQUAL "help")
    set(args --help)
    set(stdout "${usage}")
elseif(CASE STREQUAL "version")
    set(args --version)
    set(stdout "ChunkVault ${VERSION}\n")
else()
    set(status 2)
    set(stderr "${usage}")
    if(CASE STREQUAL "unknown" OR CASE STREQUAL "extra")
        set(stderr "cv: invalid arguments\n${usage}")
        set(args --unknown)
        if(CASE STREQUAL "extra")
            set(args --help extra)
        endif()
    endif()
endif()

execute_process(COMMAND "${CV}" ${args}
    RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual_stdout ERROR_VARIABLE actual_stderr)
if(NOT actual_status STREQUAL status OR NOT actual_stdout STREQUAL stdout
   OR NOT actual_stderr STREQUAL stderr)
    message(FATAL_ERROR "Unexpected CLI result: exit=${actual_status}, stdout=[${actual_stdout}], stderr=[${actual_stderr}]")
endif()
