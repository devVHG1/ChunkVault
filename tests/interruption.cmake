string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(work "${TEST_DIR}/${token}")

function(run)
    execute_process(COMMAND "${CV}" ${ARGN} RESULT_VARIABLE code
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT code STREQUAL "0")
        message(FATAL_ERROR "cv ${ARGN}: ${code}\n${stderr}")
    endif()
    set(stdout "${stdout}" PARENT_SCOPE)
endfunction()

foreach(point IN ITEMS staged-open staged-write staged-flush object-visible manifest-ready manifest-visible)
    set(root "${work}/${point}")
    set(repo "${root}/vault")
    set(source "${root}/source")
    file(MAKE_DIRECTORY "${source}")
    file(WRITE "${source}/empty" "")
    file(WRITE "${source}/data" "original")
    run(init "${repo}")
    run(backup "${repo}" "${source}" baseline)
    file(WRITE "${source}/data" "updated")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "CV_TEST_FAILPOINT=${point}"
        "${CRASH_CV}" backup "${repo}" "${source}" interrupted
        RESULT_VARIABLE code ERROR_VARIABLE stderr)
    if(NOT code STREQUAL "86" OR NOT stderr MATCHES "injected interruption: ${point}")
        message(FATAL_ERROR "Failpoint ${point} was not reached: ${code}\n${stderr}")
    endif()
    run(verify "${repo}" baseline)
    run(list "${repo}")
    if(point STREQUAL "manifest-visible")
        if(NOT stdout STREQUAL "baseline\ninterrupted\n")
            message(FATAL_ERROR "Published snapshot missing at ${point}")
        endif()
        run(verify "${repo}" interrupted)
    elseif(NOT stdout STREQUAL "baseline\n")
        message(FATAL_ERROR "Snapshot published early at ${point}")
    endif()
    run(recover "${repo}" --remove)
    file(GLOB leftovers "${repo}/objects/.*.tmp" "${repo}/snapshots/.*.tmp")
    if(leftovers)
        message(FATAL_ERROR "Recovery left temporary files at ${point}")
    endif()
    run(backup "${repo}" "${source}" retried)
    run(verify "${repo}")
    run(restore "${repo}" retried "${root}/restored")
    foreach(name IN ITEMS data empty)
        file(SHA256 "${source}/${name}" expected)
        file(SHA256 "${root}/restored/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Restored ${name} differs after ${point}")
        endif()
    endforeach()
endforeach()
file(REMOVE_RECURSE "${work}")
