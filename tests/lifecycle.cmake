file(MAKE_DIRECTORY "${TEST_DIR}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "${TEST_DIR}/${run_id}")
set(repo "${work}/repository")
set(source "${work}/source")
set(output "${work}/restore")
file(MAKE_DIRECTORY "${source}/nested/empty")
string(REPEAT "0123456789abcdef" 8192 payload)
file(WRITE "${source}/nested/content.bin" "${payload}tail")
file(WRITE "${source}/duplicate.bin" "${payload}tail")
file(WRITE "${source}/empty.txt" "")
foreach(index RANGE 1 40)
    file(WRITE "${source}/nested/empty-${index}.txt" "")
endforeach()

function(run expected)
    execute_process(COMMAND "${CV}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL expected)
        message(FATAL_ERROR "cv ${ARGN}: expected ${expected}, got ${status}\n${stdout}${stderr}")
    endif()
    set(stdout "${stdout}" PARENT_SCOPE)
    set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

run(0 init "${repo}")
run(1 init "${repo}")
run(1 backup "${repo}" "${work}" recursive)
run(1 backup "${repo}" "${repo}/snapshots" recursive)
if(UNIX)
    file(CREATE_LINK "${source}/nested/content.bin" "${source}/link.bin" SYMBOLIC)
    run(1 backup "${repo}" "${source}" link)
    if(EXISTS "${repo}/snapshots/link.cvm")
        message(FATAL_ERROR "A failed backup published a snapshot")
    endif()
    file(REMOVE "${source}/link.bin")
endif()
run(0 backup "${repo}" "${source}" first)
run(1 backup "${repo}" "${source}" first)
file(GLOB objects LIST_DIRECTORIES FALSE "${repo}/objects/*")
set(object_bytes 0)
foreach(object IN LISTS objects)
    file(SIZE "${object}" size)
    math(EXPR object_bytes "${object_bytes} + ${size}")
endforeach()
string(LENGTH "${payload}tail" one_copy)
if(object_bytes LESS 1 OR object_bytes GREATER one_copy)
    message(FATAL_ERROR "Duplicate files were not deduplicated")
endif()
run(0 backup "${repo}" "${source}" second)
file(GLOB after LIST_DIRECTORIES FALSE "${repo}/objects/*")
if(NOT after STREQUAL objects)
    message(FATAL_ERROR "The identical snapshot changed the object store")
endif()
execute_process(COMMAND "${CV}" backup "${repo}" "${source}" race
    COMMAND "${CV}" backup "${repo}" "${source}" race
    RESULTS_VARIABLE backup_race OUTPUT_QUIET ERROR_QUIET)
if(NOT backup_race STREQUAL "0;1" AND NOT backup_race STREQUAL "1;0")
    message(FATAL_ERROR "Concurrent backup did not publish exactly one snapshot: ${backup_race}")
endif()
file(GLOB backup_temps "${repo}/snapshots/.*.tmp" "${repo}/objects/.*.tmp")
if(backup_temps)
    message(FATAL_ERROR "Concurrent backup left temporary files: ${backup_temps}")
endif()
run(0 list "${repo}")
if(NOT stdout STREQUAL "first\nrace\nsecond\n")
    message(FATAL_ERROR "Snapshot list was incomplete: ${stdout}")
endif()
file(WRITE "${repo}/objects/.123-456.tmp" "staged object")
file(WRITE "${repo}/snapshots/.789.tmp" "staged legacy manifest")
file(WRITE "${repo}/snapshots/keep.tmp" "unrelated file")
run(0 recover "${repo}")
if(NOT stdout MATCHES "[.]123-456[.]tmp" OR NOT stdout MATCHES "[.]789[.]tmp"
   OR NOT EXISTS "${repo}/objects/.123-456.tmp" OR NOT EXISTS "${repo}/snapshots/.789.tmp")
    message(FATAL_ERROR "Recovery preview failed or removed data")
endif()
run(0 recover "${repo}" --remove)
if(EXISTS "${repo}/objects/.123-456.tmp" OR EXISTS "${repo}/snapshots/.789.tmp"
   OR NOT EXISTS "${repo}/snapshots/keep.tmp")
    message(FATAL_ERROR "Recovery failed to preserve unrelated files")
endif()
run(0 verify "${repo}" first)
run(0 verify "${repo}")
run(0 restore "${repo}" first "${output}")
run(1 restore "${repo}" first "${output}")
set(race_output "${work}/race-restore")
execute_process(COMMAND "${CV}" restore "${repo}" first "${race_output}"
    COMMAND "${CV}" restore "${repo}" first "${race_output}"
    RESULTS_VARIABLE restore_race OUTPUT_QUIET ERROR_QUIET)
if(NOT restore_race STREQUAL "0;1" AND NOT restore_race STREQUAL "1;0")
    message(FATAL_ERROR "Concurrent restore did not publish exactly one directory: ${restore_race}")
endif()
file(GLOB restore_temps "${race_output}.cv-*.tmp")
if(restore_temps)
    message(FATAL_ERROR "Concurrent restore left temporary directories: ${restore_temps}")
endif()
file(SHA256 "${source}/nested/content.bin" source_hash)
file(SHA256 "${output}/nested/content.bin" restored_hash)
file(SIZE "${output}/empty.txt" empty_size)
if(NOT source_hash STREQUAL restored_hash OR NOT empty_size EQUAL 0
   OR NOT IS_DIRECTORY "${output}/nested/empty")
    message(FATAL_ERROR "Restored data or directory structure differed")
endif()

run(0 backup "${repo}" "${source}" trailing)
file(APPEND "${repo}/snapshots/trailing.cvm" "unexpected bytes")
run(1 verify "${repo}" trailing)
run(1 verify "${repo}")
run(1 restore "${repo}" trailing "${work}/trailing-restore")
if(EXISTS "${work}/trailing-restore")
    message(FATAL_ERROR "Restore accepted a malformed manifest")
endif()

list(GET objects 0 damaged)
file(SIZE "${damaged}" damaged_size)
string(REPEAT "!" ${damaged_size} wrong_bytes)
file(WRITE "${damaged}" "${wrong_bytes}")
run(1 verify "${repo}" second)
if(NOT stderr MATCHES "chunk integrity check failed:")
    message(FATAL_ERROR "Same-size corruption was not diagnosed: ${stderr}")
endif()
file(WRITE "${damaged}" "corrupted")
run(1 verify "${repo}" second)
if(NOT stderr MATCHES "incorrect chunk size:")
    message(FATAL_ERROR "Missing damaged chunk diagnostic: ${stderr}")
endif()
run(1 restore "${repo}" second "${work}/corrupt-restore")
if(EXISTS "${work}/corrupt-restore")
    message(FATAL_ERROR "Restore created a directory despite failed verification")
endif()
set(golden_repo "${work}/golden-vault")
set(golden_source "${work}/golden-input")
file(MAKE_DIRECTORY "${golden_source}")
file(WRITE "${golden_source}/x" "abc")
run(0 init "${golden_repo}")
run(0 backup "${golden_repo}" "${golden_source}" bytes)
file(READ "${golden_repo}/snapshots/bytes.cvm" manifest HEX)
set(expected "4356445241465432460100000078030000000000000003000000ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad45")
if(NOT manifest STREQUAL expected)
    message(FATAL_ERROR "Manifest encoding differs from its specified byte layout: ${manifest}")
endif()

set(legacy_repo "${work}/legacy-vault")
file(MAKE_DIRECTORY "${legacy_repo}/objects" "${legacy_repo}/snapshots")
file(CONFIGURE OUTPUT "${legacy_repo}/format" CONTENT "ChunkVault draft-1" NEWLINE_STYLE UNIX)
run(0 backup "${legacy_repo}" "${golden_source}" legacy)
file(READ "${legacy_repo}/snapshots/legacy.cvm" legacy_manifest HEX)
set(legacy_expected "43564452414654314601000000780300000000000000ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad45")
if(NOT legacy_manifest STREQUAL legacy_expected)
    message(FATAL_ERROR "Legacy manifest encoding changed")
endif()
run(0 verify "${legacy_repo}" legacy)
run(0 restore "${legacy_repo}" legacy "${work}/legacy-restore")
file(READ "${work}/legacy-restore/x" legacy_restored)
if(NOT legacy_restored STREQUAL "abc")
    message(FATAL_ERROR "Legacy data did not survive restore")
endif()

string(ASCII 208 188 208 190 209 148 utf8_name)
file(WRITE "${golden_source}/${utf8_name}.txt" "Unicode filename")
run(0 backup "${golden_repo}" "${golden_source}")
string(STRIP "${stdout}" auto_id)
run(0 verify "${golden_repo}" "${auto_id}")
run(0 restore "${golden_repo}" "${auto_id}" "${work}/unicode-restore")
file(READ "${work}/unicode-restore/${utf8_name}.txt" restored_unicode)
if(NOT restored_unicode STREQUAL "Unicode filename")
    message(FATAL_ERROR "Restore changed the Unicode filename or content")
endif()
file(REMOVE "${golden_repo}/objects/ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
run(1 verify "${golden_repo}" bytes)
if(NOT stderr MATCHES "missing or unreadable chunk:.*ba7816")
    message(FATAL_ERROR "Missing chunk diagnostic did not identify the object: ${stderr}")
endif()
if(UNIX)
    set(digest ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad)
    file(CREATE_LINK "${golden_source}/x" "${golden_repo}/objects/${digest}" SYMBOLIC)
    run(1 verify "${golden_repo}" bytes)
    run(1 backup "${golden_repo}" "${golden_source}" linked-object)
    if(EXISTS "${golden_repo}/snapshots/linked-object.cvm")
        message(FATAL_ERROR "A linked object was accepted for reuse")
    endif()
endif()
execute_process(COMMAND "${FIXTURE}" WORKING_DIRECTORY "${golden_repo}/snapshots"
    RESULT_VARIABLE fixture_status)
if(NOT fixture_status STREQUAL "0")
    message(FATAL_ERROR "Could not create malformed manifest fixtures")
endif()
run(1 verify "${golden_repo}" traversal)
run(1 verify "${golden_repo}" truncated)
run(1 verify "${golden_repo}" duplicate)
run(1 restore "${golden_repo}" traversal "${work}/unsafe-output")
run(1 restore "${golden_repo}" duplicate "${work}/duplicate-output")
file(GLOB leftovers "${work}/duplicate-output*" "${work}/unsafe-output*" "${work}/evil")
if(leftovers)
    message(FATAL_ERROR "Failed restores left output behind: ${leftovers}")
endif()
set(abc_object "${golden_repo}/objects/ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
file(REMOVE "${abc_object}")
file(WRITE "${abc_object}" "abc")
run(0 verify "${golden_repo}" bytes)
file(GLOB mutations "${golden_repo}/snapshots/mut-*.cvm")
list(LENGTH mutations mutation_count)
if(NOT mutation_count EQUAL 66)
    message(FATAL_ERROR "Expected 66 mutations, got ${mutation_count}")
endif()
foreach(mutation IN LISTS mutations)
    get_filename_component(id "${mutation}" NAME_WE)
    run(1 verify "${golden_repo}" "${id}")
    run(1 restore "${golden_repo}" "${id}" "${work}/mutated-output")
endforeach()
file(GLOB mutation_outputs "${work}/mutated-output*")
if(mutation_outputs)
    message(FATAL_ERROR "Malformed manifests left restore output behind")
endif()
run(0 list "${golden_repo}")
file(REMOVE_RECURSE "${work}")
